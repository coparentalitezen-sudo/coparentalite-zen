  "structures": [
    {
      "id": "not-just",
      "regex": "(?i)\\bit'?s not (?:just|only) [^.!?\\n]{2,60}[,.] it'?s\\b",
      "name": "\"It's not just X, it's Y\"",
      "fix": "Say the one thing you actually mean. Delete the setup half."
    },
    {
      "id": "not-only",
      "regex": "(?i)\\bnot only\\b[^.!?\\n]{2,80}\\bbut also\\b",
      "name": "\"Not only X but also Y\"",
      "fix": "Split into two sentences, or drop the weaker half."
    },
    {
      "id": "isnt-about",
      "regex": "(?i)\\b(?:this|it) is(?:n'?t| not) about [^.!?\\n]{2,60}[.!] it'?s about\\b",
      "name": "\"It isn't about X. It's about Y.\"",
      "fix": "Lead with Y. The reversal is the tell."
    },
    {
      "id": "the-result",
      "regex": "(?i)^\\s*(?:the result|the best part|the kicker|the catch)\\?\\s*$",
      "name": "One-word rhetorical question line",
      "fix": "Answer it inline instead of staging a reveal."
    },
    {
      "id": "heres-what",
      "regex": "(?i)\\bhere'?s what (?:i|we) learned\\b",
      "name": "\"Here's what I learned\"",
      "fix": "State the lesson. Skip the announcement."
    },
    {
      "id": "triad",
      "regex": "(?i)\\b\\w+, \\w+, and \\w+\\.",
      "name": "Rule-of-three triad",
      "fix": "Two items or four. Three is the model's default rhythm."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Rocket / fire / bulb / sparkle / dart emoji",
      "fix": "One emoji max, and not one of these five."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Hashtag wall (5+)",
      "fix": "Three hashtags. LinkedIn stopped rewarding the wall."
    },
    {
      "id": "as-an-ai",
      "regex": "(?i)\\bas an ai\\b|\\bas a language model\\b",
      "name": "Model self-reference",
      "fix": "Delete the sentence."
    },
    {
      "id": "in-summary",
      "regex": "(?i)^\\s*(?:in summary|to summarize|in conclusion)\\b",
      "name": "Essay-closer opener",
      "fix": "A post does not need a conclusion paragraph."
    },
    {
      "id": "engagement-bait",
      "regex": "(?i)\\b(?:agree\\?|thoughts\\?|who else\\b|am i wrong\\?)\\s*$",
      "name": "Reflex engagement bait",
      "fix": "Ask a question only you could ask, about the specific thing above it."
    },
    {
      "id": "stop-scroll",
      "regex": "(?im)^\\s*(?:stop scrolling|don'?t scroll|wait[,.]? don'?t scroll)\\b",
      "name": "\"Stop scrolling\" opener",
      "fix": "The scroll-stop has to be the claim itself. Asking for attention is the tell that you have not earned it."
    },
    {
      "id": "in-this-video",
      "regex": "(?i)\\b(?:in (?:this|today'?s) (?:video|reel|post)|today i'?m going to show you|i'?m going to (?:show|teach) you how)\\b",
      "name": "Video preamble (\"in this video I'm going to show you\")",
      "fix": "Delete it and start at the payoff. The first two seconds decide the whole reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Emoji bullet list",
      "fix": "Use a hyphen or a line break. Emoji bullets are the single most template-looking thing in a caption."
    },
    {
      "id": "caps-shout",
      "regex": "\\b[A-Z]{3,}\\b(?:\\s+\\b[A-Z]{3,}\\b){2,}",
      "name": "Three or more shouted words in a row",
      "fix": "Caps are a volume knob, not a highlighter. One word, at most."
    },
    {
      "id": "follow-bait",
      "regex": "(?i)\\b(?:follow for more|tag someone who|double tap if|share this if|comment below if)\\b",
      "name": "Reflex follow or tag bait",
      "fix": "Ask for the one action this post actually earns. The generic ask trains the audience to ignore every ask."
    },
    {
      "id": "fr-pas-juste",
      "regex": "(?i)\\bce n['’]est pas (?:seulement|juste|simplement|qu['’]un\\w*)\\b[^.!?\\n]{2,60}[,.;]\\s*c['’]est\\b",
      "name": "« Ce n'est pas juste X, c'est Y »",
      "fix": "Dis directement la chose que tu veux dire. Supprime la moitié qui prépare.",
      "lang": "fr"
    },
    {
      "id": "fr-non-seulement",
      "regex": "(?i)\\bnon seulement\\b[^.!?\\n]{2,80}\\bmais (?:aussi|également|encore)\\b",
      "name": "« Non seulement X, mais aussi Y »",
      "fix": "Coupe en deux phrases, ou garde seulement la plus forte.",
      "lang": "fr"
    },
    {
      "id": "fr-nhesitez",
      "regex": "(?i)\\bn['’]h[ée]site[sz]? pas (?:à|a)\\b",
      "name": "« N'hésite pas à... »",
      "fix": "Demande l'action directement : « Écris ZEN en commentaire. »",
      "lang": "fr"
    },
    {
      "id": "fr-decouvrez",
      "regex": "(?im)(?:^|[.!?]\\s+)d[ée]couvre[sz]?\\b",
      "name": "Phrase qui commence par « Découvre / Découvrez »",
      "fix": "Formule de pub. Montre la chose : « Voici... » ou va droit au fait.",
      "lang": "fr"
    },
    {
      "id": "fr-preambule",
      "regex": "(?i)\\b(?:dans (?:cette|la) vid[ée]o|dans ce (?:post|reel|carrousel|article)|aujourd['’]hui,? (?:je|on) (?:vais|va|voulais|veux))\\b",
      "name": "Préambule (« Dans cette vidéo... »)",
      "fix": "Supprime-le et commence par ce que la personne gagne.",
      "lang": "fr"
    },
    {
      "id": "fr-follow-bait",
      "regex": "(?i)\\b(?:abonne[sz]?-(?:toi|vous)|follow pour plus|identifie[sz]? (?:quelqu['’]un|un\\w*|ton|ta)|mentionne[sz]? (?:quelqu['’]un|un\\w*)|double[- ]tape|partage[sz]? si)\\b",
      "name": "Appel réflexe à suivre ou identifier",
      "fix": "Demande la seule action que ce post mérite (ex. le mot-clé ZEN). Une demande générique apprend à ignorer toutes les demandes.",
      "lang": "fr"
    },
    {
      "id": "fr-le-saviez-vous",
      "regex": "(?i)\\ble saviez-vous\\b|\\ble savais-tu\\b",
      "name": "« Le saviez-vous ? »",
      "fix": "Donne le fait directement, c'est lui l'accroche.",
      "lang": "fr"
    },
    {
      "id": "fr-vouvoiement",
      "regex": "(?i)(?<![-\\w])(?:vous|votre|vos)\\b",
      "name": "Vouvoiement",
      "fix": "@coparentalitezen tutoie toujours. Passe en « tu / ton / ta ».",
      "lang": "fr"
    },
    {
      "id": "fr-mots-a-eviter",
      "regex": "(?i)\\b(?:dettes?|ton ex|refus[ée]e?s?|ignor[ée]e?s?|conflits?|guerre|gagner contre)\\b",
      "name": "Mot à éviter pour @coparentalitezen",
      "fix": "Voir voice.md : dis « montant à régulariser », « l'autre parent », « en attente de réponse ». Jamais un parent fautif.",
      "lang": "fr"
    },
    {
      "id": "fr-conseil-juridique",
      "regex": "(?i)\\b(?:pension alimentaire|droit de garde|juge aux affaires familiales|jaf|jugement|avocat)\\b",
      "name": "Sujet juridique",
      "fix": "Pas de conseil juridique : renvoie vers un avocat ou un médiateur, et vérifie la formulation.",
      "lang": "fr"
    }
  ]
