# ============================================================
# Variables d'environnement — Coparentalité Zen
# Copier en .env.local pour le développement ; renseigner dans Vercel
# (Settings → Environment Variables) pour la production.
# ============================================================

# ---------- Supabase : public, exposé au navigateur ----------
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# ---------- Supabase : SECRET, jamais exposé ----------
# Utilisée par le seul webhook Stripe, qui doit créditer un foyer sans session
# authentifiée. Cette clé contourne la RLS : elle ne doit figurer que côté
# serveur, et jamais dans une variable préfixée NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Stripe : SECRET ----------
# Tableau de bord Stripe → Developers → API keys
STRIPE_SECRET_KEY=

# Tableau de bord Stripe → Developers → Webhooks → votre endpoint →
# « Signing secret ». Sans lui, la signature ne peut pas être vérifiée et
# n'importe qui pourrait s'offrir un abonnement : le webhook refuse alors tout.
STRIPE_WEBHOOK_SECRET=

# Les identifiants de tarif Stripe ne sont PAS des variables d'environnement :
# ils vivent dans la table plans, à côté des montants qu'ils représentent.
# C'est ce qui empêche d'annoncer un prix et d'en facturer un autre.
#
# Après avoir créé vos tarifs dans Stripe (Product catalog → Pricing → API ID) :
#   update plans set
#     stripe_price_id_monthly = 'price_...',
#     stripe_price_id_yearly  = 'price_...'
#   where id = 'premium';
#
# Et pour ajuster un prix, une seule requête suffit :
#   update plans set price_cents_monthly = 149, price_cents_yearly = 1499
#   where id = 'premium';

# ---------- Tâches planifiées ----------
# Protège la route d'import du calendrier scolaire officiel. Vercel l'envoie
# automatiquement aux tâches planifiées déclarées dans vercel.json ; sans elle,
# la route refuse tout appel.
# Générer une valeur aléatoire longue : openssl rand -hex 32
CRON_SECRET=

# ---------- Adresse publique du site ----------
# Sert à construire les URL de retour après paiement. Sur Vercel, VERCEL_URL
# fait office de repli ; renseignez ceci dès qu'un domaine définitif existe.
NEXT_PUBLIC_SITE_URL=https://coparentalite-zen-yvtn.vercel.app

# ---------- Pinterest : vérification du domaine ----------
# Pinterest Business → Paramètres → Comptes associés → Sites web → Revendiquer.
# Choisir la balise HTML et ne conserver ici que la valeur de « content ».
# Cette valeur n'est pas un mot de passe ; elle permet à Pinterest de constater
# que ce déploiement contrôle bien le domaine public.
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=

# ============================================================
# Sans les deux variables STRIPE_*, les paiements sont simplement
# indisponibles : l'écran d'offre l'annonce, et le reste de l'application
# fonctionne normalement. Aucun écran ne prétend encaisser sans pouvoir le faire.
#
# Les extensions n'exigent pas de tarif préenregistré : leur montant est lu
# dans la table plan_extensions. Vous pouvez néanmoins renseigner
# plan_extensions.stripe_price_id pour les rattacher à votre catalogue Stripe.
# ============================================================

# ---------- Notifications poussées (Web Push) ----------
# Paire de clés VAPID : elle identifie votre serveur auprès d'Apple, Google et
# Mozilla. Générez-la une seule fois puis conservez-la — la changer
# invaliderait tous les abonnements existants.
#   npx web-push generate-vapid-keys
#
# La clé publique est exposée au navigateur, d'où le préfixe NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# La clé privée ne doit jamais quitter le serveur.
VAPID_PRIVATE_KEY=
# Adresse de contact exigée par le protocole, en cas de problème de livraison.
VAPID_CONTACT=mailto:contact@votre-domaine.fr
#
# SUR IPHONE : les alertes exigent iOS 16.4 et que l'application soit installée
# sur l'écran d'accueil. Depuis Safari, la permission ne peut pas être demandée.


# ---------- Identité légale publique ----------
# Obligatoire avant commercialisation publique. Ces valeurs apparaissent dans
# les mentions légales, les CGU et la politique de confidentialité.
NEXT_PUBLIC_LEGAL_NAME=Nom ou raison sociale
NEXT_PUBLIC_LEGAL_FORM=Micro-entreprise
NEXT_PUBLIC_LEGAL_SIREN=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_DIRECTOR=
NEXT_PUBLIC_SUPPORT_EMAIL=contact@votre-domaine.fr
NEXT_PUBLIC_MEDIATOR=Nom et coordonnées du médiateur de la consommation
